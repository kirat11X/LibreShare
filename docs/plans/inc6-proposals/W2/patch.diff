--- /dev/null
+++ b/packages/libreshare_core/lib/src/rendezvous/bip340.dart
@@ -0,0 +1,189 @@
+// BIP-340 Schnorr signatures over secp256k1 using pointycastle primitives.
+library;
+
+import 'dart:convert';
+import 'dart:typed_data';
+
+import 'package:crypto/crypto.dart' as crypto;
+import 'package:pointycastle/ecc/api.dart';
+import 'package:pointycastle/ecc/curves/secp256k1.dart';
+
+import '../security/crypto_primitives.dart';
+
+final ECCurve_secp256k1 _secp256k1 = ECCurve_secp256k1();
+
+/// Field prime p = 2^256 - 2^32 - 977
+final BigInt _p = BigInt.parse(
+  'FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEFFFFFC2F',
+  radix: 16,
+);
+
+/// Curve group order n
+final BigInt _n = _secp256k1.n;
+
+/// Base generator point G
+final ECPoint _generatorG = _secp256k1.G;
+
+/// Computes BIP-340 tagged SHA-256 hash: SHA256(SHA256(tag) || SHA256(tag) || msg).
+Uint8List bip340TaggedHash(String tag, List<int> msg) {
+  final tagHash = crypto.sha256.convert(utf8.encode(tag)).bytes;
+  final bb = BytesBuilder(copy: false);
+  bb.add(tagHash);
+  bb.add(tagHash);
+  bb.add(msg);
+  return Uint8List.fromList(crypto.sha256.convert(bb.takeBytes()).bytes);
+}
+
+/// Parses big-endian bytes into a [BigInt].
+BigInt bytesToBigInt(List<int> bytes) {
+  final hex = bytes.map((b) => b.toRadixString(16).padLeft(2, '0')).join();
+  return BigInt.parse(hex, radix: 16);
+}
+
+/// Returns true if [pt] has an even y-coordinate.
+bool hasEvenY(ECPoint pt) {
+  final y = pt.y?.toBigInteger();
+  if (y == null) return false;
+  return (y % BigInt.two) == BigInt.zero;
+}
+
+/// Derives the 32-byte BIP-340 x-only public key from a private key [sk].
+Uint8List getBip340PublicKey(BigInt sk) {
+  if (sk <= BigInt.zero || sk >= _n) {
+    throw ArgumentError('Secret key out of range [1, n-1]');
+  }
+  final P = _generatorG * sk;
+  if (P == null || P.isInfinity) {
+    throw ArgumentError('Invalid secret key');
+  }
+  return bigIntToBytes(P.x!.toBigInteger()!, 32);
+}
+
+/// Signs a 32-byte [message] using private key [sk] and optional [auxRand] per BIP-340.
+///
+/// Returns 64-byte Schnorr signature (32-byte R.x || 32-byte s).
+Uint8List signBip340({
+  required BigInt sk,
+  required Uint8List message,
+  Uint8List? auxRand,
+}) {
+  if (sk <= BigInt.zero || sk >= _n) {
+    throw ArgumentError('Secret key out of range [1, n-1]');
+  }
+  if (message.length != 32) {
+    throw ArgumentError('Message must be exactly 32 bytes');
+  }
+
+  final P = _generatorG * sk;
+  if (P == null || P.isInfinity) {
+    throw ArgumentError('Invalid secret key');
+  }
+
+  var d = sk;
+  if (!hasEvenY(P)) {
+    d = _n - d;
+  }
+
+  final aux = auxRand ?? Uint8List(32);
+  final t = Uint8List(32);
+  final skBytes = bigIntToBytes(d, 32);
+  final auxHash = bip340TaggedHash('BIP0340/aux', aux);
+  for (var i = 0; i < 32; i++) {
+    t[i] = skBytes[i] ^ auxHash[i];
+  }
+
+  final pxBytes = bigIntToBytes(P.x!.toBigInteger()!, 32);
+  final nonceBytes = BytesBuilder(copy: false);
+  nonceBytes.add(t);
+  nonceBytes.add(pxBytes);
+  nonceBytes.add(message);
+
+  final rand = bip340TaggedHash('BIP0340/nonce', nonceBytes.takeBytes());
+  final kPrime = bytesToBigInt(rand) % _n;
+  if (kPrime == BigInt.zero) {
+    throw StateError('Derived kPrime is zero');
+  }
+
+  final R = _generatorG * kPrime;
+  if (R == null || R.isInfinity) {
+    throw StateError('Derived R point is infinity');
+  }
+
+  var k = kPrime;
+  if (!hasEvenY(R)) {
+    k = _n - k;
+  }
+
+  final rxBytes = bigIntToBytes(R.x!.toBigInteger()!, 32);
+  final chalBytes = BytesBuilder(copy: false);
+  chalBytes.add(rxBytes);
+  chalBytes.add(pxBytes);
+  chalBytes.add(message);
+
+  final e =
+      bytesToBigInt(
+        bip340TaggedHash('BIP0340/challenge', chalBytes.takeBytes()),
+      ) %
+      _n;
+  final s = (k + e * d) % _n;
+
+  final sig = Uint8List(64);
+  sig.setRange(0, 32, rxBytes);
+  sig.setRange(32, 64, bigIntToBytes(s, 32));
+  return sig;
+}
+
+/// Verifies a 64-byte BIP-340 Schnorr [sig] against 32-byte [pubKeyBytes] and [message].
+bool verifyBip340({
+  required Uint8List pubKeyBytes,
+  required Uint8List message,
+  required Uint8List sig,
+}) {
+  if (pubKeyBytes.length != 32 || sig.length != 64 || message.length != 32) {
+    return false;
+  }
+
+  final px = bytesToBigInt(pubKeyBytes);
+  if (px >= _p) return false;
+
+  // lift_x: y^2 = x^3 + 7 mod p
+  final ySquared = (px.modPow(BigInt.from(3), _p) + BigInt.from(7)) % _p;
+  // p = 3 mod 4, so sqrt(y^2) = (y^2)^((p+1)/4) mod p
+  final exp = (_p + BigInt.one) ~/ BigInt.from(4);
+  var y = ySquared.modPow(exp, _p);
+  if ((y.modPow(BigInt.two, _p)) != ySquared) {
+    return false; // Point not on curve
+  }
+  if ((y % BigInt.two) != BigInt.zero) {
+    y = _p - y;
+  }
+
+  final P = _secp256k1.curve.createPoint(px, y);
+
+  final rx = bytesToBigInt(sig.sublist(0, 32));
+  final s = bytesToBigInt(sig.sublist(32, 64));
+  if (rx >= _p || s >= _n) return false;
+
+  final chalBytes = BytesBuilder(copy: false);
+  chalBytes.add(sig.sublist(0, 32));
+  chalBytes.add(pubKeyBytes);
+  chalBytes.add(message);
+
+  final e =
+      bytesToBigInt(
+        bip340TaggedHash('BIP0340/challenge', chalBytes.takeBytes()),
+      ) %
+      _n;
+
+  // R = s*G - e*P = s*G + (n - e)*P
+  final sG = _generatorG * s;
+  final negEP = P * (_n - e);
+  if (sG == null || negEP == null) return false;
+
+  final R = sG + negEP;
+  if (R == null || R.isInfinity || !hasEvenY(R) || R.x!.toBigInteger() != rx) {
+    return false;
+  }
+
+  return true;
+}
diff --git a/packages/libreshare_core/lib/src/rendezvous/loopback_nostr_relay.dart b/packages/libreshare_core/lib/src/rendezvous/loopback_nostr_relay.dart
new file mode 100644
index 0000000..78e372c
--- /dev/null
+++ b/packages/libreshare_core/lib/src/rendezvous/loopback_nostr_relay.dart
@@ -0,0 +1,230 @@
+// In-process WebSocket Nostr Relay on 127.0.0.1 for integration testing.
+library;
+
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+import 'nip01.dart';
+
+/// Subscription state on a client connection.
+class _Subscription {
+  _Subscription({
+    required this.subId,
+    required this.pTags,
+    required this.kinds,
+  });
+  final String subId;
+  final Set<String> pTags;
+  final Set<int> kinds;
+
+  bool matches(NostrEvent event) {
+    if (kinds.isNotEmpty && !kinds.contains(event.kind)) {
+      return false;
+    }
+    if (pTags.isEmpty) return true;
+    for (final tag in event.tags) {
+      if (tag.isNotEmpty && tag[0] == 'p' && tag.length > 1) {
+        if (pTags.contains(tag[1].toLowerCase())) return true;
+      }
+    }
+    return false;
+  }
+}
+
+/// Hermetic in-process Nostr relay over real localhost WebSockets.
+class LoopbackNostrRelay {
+  LoopbackNostrRelay({this.verifySignatures = true});
+
+  final bool verifySignatures;
+  HttpServer? _server;
+  final List<WebSocket> _clients = [];
+  final Map<WebSocket, Map<String, _Subscription>> _clientSubs = {};
+  final List<NostrEvent> _events = [];
+
+  bool _isKilled = false;
+
+  int get port => _server?.port ?? 0;
+  Uri get url => Uri.parse('ws://127.0.0.1:$port');
+
+  /// Starts the relay on an ephemeral localhost port.
+  Future<void> start() async {
+    _server = await HttpServer.bind('127.0.0.1', 0);
+    _server!.listen(_handleHttpRequest);
+  }
+
+  void _handleHttpRequest(HttpRequest request) {
+    if (_isKilled) {
+      request.response.statusCode = HttpStatus.serviceUnavailable;
+      request.response.close();
+      return;
+    }
+
+    if (WebSocketTransformer.isUpgradeRequest(request)) {
+      WebSocketTransformer.upgrade(request).then(_handleWebSocket);
+    } else {
+      // NIP-11 Information Document
+      request.response.headers.contentType = ContentType(
+        'application',
+        'nostr+json',
+      );
+      request.response.write(
+        jsonEncode({
+          'name': 'LibreShare Test Relay',
+          'description': 'In-process loopback relay for automated testing',
+          'supported_nips': [1, 11, 40],
+          'software': 'libreshare-loopback',
+          'version': '1.0.0',
+        }),
+      );
+      request.response.close();
+    }
+  }
+
+  void _handleWebSocket(WebSocket ws) {
+    if (_isKilled) {
+      ws.close();
+      return;
+    }
+    _clients.add(ws);
+    _clientSubs[ws] = {};
+
+    ws.listen(
+      (data) => _handleClientMessage(ws, data),
+      onDone: () => _removeClient(ws),
+      onError: (_) => _removeClient(ws),
+    );
+  }
+
+  void _removeClient(WebSocket ws) {
+    _clients.remove(ws);
+    _clientSubs.remove(ws);
+  }
+
+  void _handleClientMessage(WebSocket ws, dynamic data) {
+    if (data is! String) return;
+
+    final dynamic parsed;
+    try {
+      parsed = jsonDecode(data);
+    } catch (_) {
+      ws.add(jsonEncode(['NOTICE', 'error: malformed JSON']));
+      return;
+    }
+
+    if (parsed is! List || parsed.isEmpty) return;
+    final msgType = parsed[0] as String?;
+
+    switch (msgType) {
+      case 'EVENT':
+        if (parsed.length < 2 || parsed[1] is! Map<String, dynamic>) {
+          ws.add(jsonEncode(['NOTICE', 'error: invalid EVENT payload']));
+          return;
+        }
+        final eventMap = parsed[1] as Map<String, dynamic>;
+        final event = NostrEvent.fromJson(eventMap);
+
+        if (verifySignatures && !event.verify()) {
+          ws.add(
+            jsonEncode([
+              'OK',
+              event.id,
+              false,
+              'invalid: signature verification failed',
+            ]),
+          );
+          return;
+        }
+
+        _events.add(event);
+        ws.add(jsonEncode(['OK', event.id, true, '']));
+
+        // Broadcast to all matching client subscriptions
+        _broadcastEvent(event);
+        break;
+
+      case 'REQ':
+        if (parsed.length < 3) return;
+        final subId = parsed[1] as String? ?? '';
+        final pTags = <String>{};
+        final kinds = <int>{};
+
+        for (var i = 2; i < parsed.length; i++) {
+          if (parsed[i] is Map<String, dynamic>) {
+            final f = parsed[i] as Map<String, dynamic>;
+            final pList = (f['#p'] as List?)?.cast<String>();
+            if (pList != null) {
+              pTags.addAll(pList.map((p) => p.toLowerCase()));
+            }
+            final kList = (f['kinds'] as List?)?.cast<int>();
+            if (kList != null) {
+              kinds.addAll(kList);
+            }
+          }
+        }
+
+        final sub = _Subscription(subId: subId, pTags: pTags, kinds: kinds);
+        _clientSubs[ws]?[subId] = sub;
+
+        // Deliver existing matching events
+        for (final ev in _events) {
+          if (sub.matches(ev)) {
+            ws.add(jsonEncode(['EVENT', subId, ev.toJson()]));
+          }
+        }
+        ws.add(jsonEncode(['EOSE', subId]));
+        break;
+
+      case 'CLOSE':
+        if (parsed.length >= 2) {
+          final subId = parsed[1] as String? ?? '';
+          _clientSubs[ws]?.remove(subId);
+        }
+        break;
+    }
+  }
+
+  void _broadcastEvent(NostrEvent event) {
+    for (final ws in List<WebSocket>.from(_clients)) {
+      final subs = _clientSubs[ws];
+      if (subs == null) continue;
+
+      for (final sub in subs.values) {
+        if (sub.matches(event)) {
+          try {
+            ws.add(jsonEncode(['EVENT', sub.subId, event.toJson()]));
+          } catch (_) {}
+        }
+      }
+    }
+  }
+
+  /// Injects an oversized frame (> 128 KiB) to all connected clients.
+  void injectOversizedFrame() {
+    final oversized = jsonEncode(['EVENT', 'test', 'A' * (130 * 1024)]);
+    for (final ws in List<WebSocket>.from(_clients)) {
+      try {
+        ws.add(oversized);
+      } catch (_) {}
+    }
+  }
+
+  /// Terminates the relay abruptly (simulating network cut or crash mid-run).
+  Future<void> killMidRun() async {
+    _isKilled = true;
+    for (final ws in List<WebSocket>.from(_clients)) {
+      try {
+        await ws.close(WebSocketStatus.goingAway, 'Relay killed');
+      } catch (_) {}
+    }
+    _clients.clear();
+    _clientSubs.clear();
+    await _server?.close(force: true);
+    _server = null;
+  }
+
+  /// Cleanly closes the relay.
+  Future<void> stop() async {
+    await killMidRun();
+  }
+}
diff --git a/packages/libreshare_core/lib/src/rendezvous/nip01.dart b/packages/libreshare_core/lib/src/rendezvous/nip01.dart
