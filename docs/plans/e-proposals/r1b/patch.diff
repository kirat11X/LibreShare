-  lan('lan', defaultCostHint: 20),
-
-  /// User-specified or QR-scanned manual address.
-  manual('manual', defaultCostHint: 30),
-
-  /// Local loopback connection (tests, local development).
-  loopback('loopback', defaultCostHint: 5),
