+  // Address of the listed peer that announced [fp]; a shared bucket when the
+  // fingerprint is not listed or is claimed by more than one deviceId (a
+  // fingerprint is public, so a claim must not steer the attribution).
+  String _sourceOf(String fp) {
+    String? address;
+    String? claimant;
+    for (final e in _peers.entries) {
+      if (e.value.device.info.fingerprint.toUpperCase() != fp) continue;
+      if (claimant != null && claimant != e.key) return _unknownSource;
+      claimant = e.key;
+      address ??= e.value.device.address;
+    }
+    return address ?? _unknownSource;
+  }
