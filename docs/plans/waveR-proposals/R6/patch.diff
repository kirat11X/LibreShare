diff --git a/tools/release/package-android.sh b/tools/release/package-android.sh
new file mode 100755
index 0000000..8da0a69
--- /dev/null
+++ b/tools/release/package-android.sh
@@ -0,0 +1,30 @@
+#!/usr/bin/env bash
+# tools/release/package-android.sh
+# Builds Android release APK and SHA-256 checksum.
+# Follows strict project safety rules: NO SIGNING KEYS IN THE REPO.
+set -euo pipefail
+
+REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+DIST_DIR="$REPO_ROOT/dist"
+mkdir -p "$DIST_DIR"
+
+cd "$REPO_ROOT/apps/libreshare_app"
+flutter pub get
+
+echo "=== Building LibreShare Android APK ==="
+# Builds split APKs or universal fat APK
+flutter build apk --release
+
+APK_SRC="$REPO_ROOT/apps/libreshare_app/build/app/outputs/flutter-apk/app-release.apk"
+APK_DEST="$DIST_DIR/libreshare-android.apk"
+
+if [[ -f "$APK_SRC" ]]; then
+  cp "$APK_SRC" "$APK_DEST"
+  cd "$DIST_DIR"
+  sha256sum "libreshare-android.apk" > "libreshare-android.apk.sha256"
+  echo "Android APK packaged successfully: $APK_DEST"
+  sha256sum -c "libreshare-android.apk.sha256"
+else
+  echo "Error: Release APK not found at $APK_SRC" >&2
+  exit 1
+fi
diff --git a/tools/release/package-linux.sh b/tools/release/package-linux.sh
new file mode 100755
index 0000000..77e3405
--- /dev/null
+++ b/tools/release/package-linux.sh
@@ -0,0 +1,32 @@
+#!/usr/bin/env bash
+# tools/release/package-linux.sh
+# Builds Linux x86_64 release tarball and SHA-256 checksum.
+set -euo pipefail
+
+REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+DIST_DIR="$REPO_ROOT/dist"
+mkdir -p "$DIST_DIR"
+
+echo "=== Building LibreShare CLI for Linux x64 ==="
+cd "$REPO_ROOT/packages/libreshare_cli"
+dart pub get
+dart compile exe bin/ls.dart -o "$DIST_DIR/libreshare-cli"
+
+echo "=== Building LibreShare Flutter Desktop for Linux x64 ==="
+cd "$REPO_ROOT/apps/libreshare_app"
+flutter config --enable-linux-desktop
+flutter pub get
+flutter build linux --release
+
+BUNDLE_DIR="$REPO_ROOT/apps/libreshare_app/build/linux/x64/release/bundle"
+ARCHIVE_NAME="libreshare-linux-x64.tar.gz"
+echo "=== Packaging $ARCHIVE_NAME ==="
+tar -czf "$DIST_DIR/$ARCHIVE_NAME" -C "$BUNDLE_DIR" .
+
+echo "=== Generating SHA-256 Checksums ==="
+cd "$DIST_DIR"
+sha256sum "$ARCHIVE_NAME" > "$ARCHIVE_NAME.sha256"
+sha256sum "libreshare-cli" > "libreshare-cli.sha256"
+
+echo "Release artifacts built successfully in $DIST_DIR:"
+ls -lh "$DIST_DIR"/*
diff --git a/tools/release/package-windows.ps1 b/tools/release/package-windows.ps1
new file mode 100644
index 0000000..7e75a39
--- /dev/null
+++ b/tools/release/package-windows.ps1
@@ -0,0 +1,39 @@
+# tools/release/package-windows.ps1
+# Builds Windows x64 release zip archive and SHA-256 checksum.
+# Run from repository root in PowerShell.
+$ErrorActionPreference = "Stop"
+
+$RepoRoot = Split-Path -Parent (Split-Path -Parent $PSScriptRoot)
+if (-not $RepoRoot) { $RepoRoot = Get-Location }
+$DistDir = Join-Path $RepoRoot "dist"
+New-Item -ItemType Directory -Path $DistDir -Force | Out-Null
+
+Write-Host "=== Building LibreShare CLI for Windows x64 ==="
+Set-Location (Join-Path $RepoRoot "packages\libreshare_cli")
+dart pub get
+$CliExe = Join-Path $DistDir "libreshare-cli.exe"
+dart compile exe bin\ls.dart -o $CliExe
+
+Write-Host "=== Building LibreShare Flutter Desktop for Windows x64 ==="
+Set-Location (Join-Path $RepoRoot "apps\libreshare_app")
+flutter config --enable-windows-desktop
+flutter pub get
+flutter build windows --release
+
+$BundleDir = Join-Path $RepoRoot "apps\libreshare_app\build\windows\x64\runner\Release"
+$ArchiveName = "libreshare-windows-x64.zip"
+$ZipPath = Join-Path $DistDir $ArchiveName
+
+Write-Host "=== Packaging $ArchiveName ==="
+Compress-Archive -Path "$BundleDir\*" -DestinationPath $ZipPath -Force
+
+Write-Host "=== Generating SHA-256 Checksums ==="
+Set-Location $DistDir
+$ZipHash = (Get-FileHash -Algorithm SHA256 $ArchiveName).Hash
+"$ZipHash  $ArchiveName" | Out-File -FilePath "$ArchiveName.sha256" -Encoding ascii
+
+$CliHash = (Get-FileHash -Algorithm SHA256 "libreshare-cli.exe").Hash
+"$CliHash  libreshare-cli.exe" | Out-File -FilePath "libreshare-cli.exe.sha256" -Encoding ascii
+
+Write-Host "Windows release artifacts built successfully in $DistDir"
+Get-ChildItem $DistDir
