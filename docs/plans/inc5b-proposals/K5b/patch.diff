--- a/tools/docker/e2e.sh
+++ b/tools/docker/e2e.sh
@@ -71,11 +71,28 @@
 }
 dropped_pkts() { "$IPT" -nvxL INPUT | awk -v p="dpt:$PORT" '$0 ~ p {print $1; exit}'; }
 BG_PIDS=()
+
+# Global watchdog: terminate entire script process group if total execution exceeds 15 minutes (900 s)
+WATCHDOG_TIMEOUT_SEC=${E2E_WATCHDOG_TIMEOUT:-900}
+(
+  sleep "$WATCHDOG_TIMEOUT_SEC"
+  printf '
+
+*** E2E WATCHDOG TIMEOUT: e2e.sh exceeded %d seconds (hung process detected) ***
+' "$WATCHDOG_TIMEOUT_SEC" >&2
+  kill -TERM "$$" 2>/dev/null || true
+  sleep 5
+  kill -KILL "$$" 2>/dev/null || true
+) &
+WATCHDOG_PID=$!
+BG_PIDS+=("$WATCHDOG_PID")
+
 cleanup() {
   undo_drop
+  if [[ -n "${WATCHDOG_PID:-}" ]]; then kill "$WATCHDOG_PID" 2>/dev/null || true; fi
   if ((${#BG_PIDS[@]})); then kill "${BG_PIDS[@]}" 2>/dev/null || true; fi
 }
-trap cleanup EXIT
+trap cleanup EXIT INT TERM
 
 # --- helpers ----------------------------------------------------------------------------------------
 # discover_timed LIMIT_S "alias alias" [extra `devices` args]
@@ -718,7 +735,7 @@
 done
 
 fault_clean
-trap - EXIT INT TERM
+trap cleanup EXIT INT TERM
 kill "$o_rx_pid" 2>/dev/null || true
 rm -f /tmp/e2e-o.bin "$RX_DIR_O"/e2e-o.bin*
 
@@ -750,24 +767,68 @@
 
 # 1. Direct origin reachability probe: unpinned direct connections rejected
 rc_unpinned=0
-out_unpinned=$(timeout 2 nc -zv "$BOB_IP" 53330 2>&1) || rc_unpinned=$?
+out_unpinned=$(timeout 5 nc -zv "$BOB_IP" 53330 2>&1) || rc_unpinned=$?
 check "direct origin port closed or rejects unpinned connection" test "$rc_unpinned" -ne 0 -o -n "$out_unpinned"
 
 # 2. CLI link --hide-ip generates tunnel-only link suppressing direct candidate disclosure
-rc_hide=0
-out_hide=$("$LS" link /tmp/e2e-q.bin --provider fake --hide-ip --insecure-plaintext 2>&1) || rc_hide=$?
-check "CLI link with --hide-ip confirms tunnel-only" grep -q "HIDE-IP:" <<<"$out_hide"
-check "CLI link with --hide-ip omits direct candidate disclosure" ! grep -q "DISCLOSURE:" <<<"$out_hide"
+rm -f /tmp/link-hide.log
+timeout 30 "$LS" link /tmp/e2e-q.bin --provider fake --hide-ip --insecure-plaintext >/tmp/link-hide.log 2>&1 &
+hide_pid=$!
+BG_PIDS+=("$hide_pid")
+
+link_hide_ready=0
+for _ in {1..30}; do
+  if grep -q '^LINK ' /tmp/link-hide.log 2>/dev/null; then
+    link_hide_ready=1
+    break
+  fi
+  sleep 1
+done
+
+if [[ "$link_hide_ready" -eq 1 ]]; then
+  check "CLI link with --hide-ip confirms tunnel-only" grep -q "HIDE-IP:" /tmp/link-hide.log
+  check "CLI link with --hide-ip omits direct candidate disclosure" ! grep -q "DISCLOSURE:" /tmp/link-hide.log
+else
+  bad "CLI link with --hide-ip failed to start within 30 s"
+  echo "--- last 10 lines of /tmp/link-hide.log ---"
+  tail -n 10 /tmp/link-hide.log 2>/dev/null || true
+fi
+
+kill "$hide_pid" 2>/dev/null || true
+wait "$hide_pid" 2>/dev/null || true
+rm -f /tmp/link-hide.log
 
 # 3. CLI link without --hide-ip includes mandatory direct candidate disclosure
-rc_disc=0
-out_disc=$("$LS" link /tmp/e2e-q.bin --provider fake --insecure-plaintext 2>&1) || rc_disc=$?
-check "CLI link without --hide-ip includes direct candidate disclosure" grep -q "DISCLOSURE:" <<<"$out_disc"
+rm -f /tmp/link-disc.log
+timeout 30 "$LS" link /tmp/e2e-q.bin --provider fake --insecure-plaintext >/tmp/link-disc.log 2>&1 &
+disc_pid=$!
+BG_PIDS+=("$disc_pid")
+
+link_disc_ready=0
+for _ in {1..30}; do
+  if grep -q '^LINK ' /tmp/link-disc.log 2>/dev/null; then
+    link_disc_ready=1
+    break
+  fi
+  sleep 1
+done
+
+if [[ "$link_disc_ready" -eq 1 ]]; then
+  check "CLI link without --hide-ip includes direct candidate disclosure" grep -q "DISCLOSURE:" /tmp/link-disc.log
+else
+  bad "CLI link without --hide-ip failed to start within 30 s"
+  echo "--- last 10 lines of /tmp/link-disc.log ---"
+  tail -n 10 /tmp/link-disc.log 2>/dev/null || true
+fi
+
+kill "$disc_pid" 2>/dev/null || true
+wait "$disc_pid" 2>/dev/null || true
+rm -f /tmp/link-disc.log
 
 # 4. Gateway reachability from lan_net to inet_net
 GATEWAY_IP="${GATEWAY_IP:-172.28.5.254}"
 rc_gw=0
-out_gw=$(ping -c 1 -W 2 "$GATEWAY_IP" 2>&1) || rc_gw=$?
+out_gw=$(timeout 5 ping -c 1 -W 2 "$GATEWAY_IP" 2>&1) || rc_gw=$?
 check "gateway is reachable from lan_net" test "$rc_gw" -eq 0 -o -n "$out_gw"
 
