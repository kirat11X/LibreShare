--- a/packages/libreshare_core/lib/src/nat/fake_igd_gateway.dart
+++ b/packages/libreshare_core/lib/src/nat/fake_igd_gateway.dart
@@ -0,0 +1,234 @@
+// Test fake UPnP IGD router for Increment 5b.
+
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+class FakeIgdGateway {
+  FakeIgdGateway({
+    this.externalIp = '203.0.113.1',
+    this.conflictPort,
+    this.permanentOnly = false,
+    this.failAll = false,
+    this.oversizeXml = false,
+    this.includeDtd = false,
+    this.delay = Duration.zero,
+  });
+
+  final String externalIp;
+  int? conflictPort;
+  bool permanentOnly;
+  bool failAll;
+  bool oversizeXml;
+  bool includeDtd;
+  Duration delay;
+
+  HttpServer? _server;
+  final List<Map<String, dynamic>> _activeMappings = [];
+
+  List<Map<String, dynamic>> get activeMappings =>
+      List.unmodifiable(_activeMappings);
+  int get port => _server?.port ?? 0;
+  Uri get locationUri => Uri.parse('http://127.0.0.1:$port/rootDesc.xml');
+
+  Future<void> start() async {
+    _server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+    _server!.listen(_handleRequest);
+  }
+
+  Future<void> close() async {
+    await _server?.close(force: true);
+    _server = null;
+  }
+
+  Future<void> _handleRequest(HttpRequest request) async {
+    if (delay > Duration.zero) {
+      await Future<void>.delayed(delay);
+    }
+
+    final path = request.uri.path;
+    if (request.method == 'GET' && path == '/rootDesc.xml') {
+      _serveDeviceDesc(request);
+    } else if (request.method == 'POST' && path == '/control/WANIPConnection') {
+      await _handleSoapControl(request);
+    } else {
+      request.response.statusCode = HttpStatus.notFound;
+      await request.response.close();
+    }
+  }
+
+  void _serveDeviceDesc(HttpRequest request) {
+    request.response.headers.contentType = ContentType(
+      'text',
+      'xml',
+      charset: 'utf-8',
+    );
+
+    if (oversizeXml) {
+      final bigPadding = '<!-- ${'A' * (70 * 1024)} -->\n';
+      request.response.write(
+        '$bigPadding<root><device><friendlyName>Oversize</friendlyName></device></root>',
+      );
+      request.response.close();
+      return;
+    }
+
+    if (includeDtd) {
+      request.response.write(
+        '<?xml version="1.0"?>\n<!DOCTYPE root [<!ENTITY xxe SYSTEM "file:///etc/passwd">]>\n<root>&xxe;</root>',
+      );
+      request.response.close();
+      return;
+    }
+
+    final xml = '''<?xml version="1.0"?>
+<root xmlns="urn:schemas-upnp-org:device-1-0">
+  <device>
+    <deviceType>urn:schemas-upnp-org:device:InternetGatewayDevice:1</deviceType>
+    <friendlyName>Fake IGD Gateway</friendlyName>
+    <serviceList>
+      <service>
+        <serviceType>urn:schemas-upnp-org:service:WANIPConnection:1</serviceType>
+        <serviceId>urn:upnp-org:serviceId:WANIPConn1</serviceId>
+        <controlURL>/control/WANIPConnection</controlURL>
+      </service>
+    </serviceList>
+  </device>
+</root>''';
+    request.response.write(xml);
+    request.response.close();
+  }
+
+  Future<void> _handleSoapControl(HttpRequest request) async {
+    final body = await utf8.decodeStream(request);
+    final soapAction = request.headers.value('SOAPACTION') ?? '';
+
+    request.response.headers.contentType = ContentType(
+      'text',
+      'xml',
+      charset: 'utf-8',
+    );
+
+    if (failAll) {
+      request.response.statusCode = HttpStatus.internalServerError;
+      request.response.write(_soapFault(501, 'ActionFailed'));
+      await request.response.close();
+      return;
+    }
+
+    if (soapAction.contains('GetExternalIPAddress') ||
+        body.contains('GetExternalIPAddress')) {
+      final resp =
+          '''<?xml version="1.0"?>
+<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/">
+  <s:Body>
+    <u:GetExternalIPAddressResponse xmlns:u="urn:schemas-upnp-org:service:WANIPConnection:1">
+      <NewExternalIPAddress>$externalIp</NewExternalIPAddress>
+    </u:GetExternalIPAddressResponse>
+  </s:Body>
+</s:Envelope>''';
+      request.response.statusCode = HttpStatus.ok;
+      request.response.write(resp);
+      await request.response.close();
+      return;
+    }
+
+    if (soapAction.contains('AddPortMapping') ||
+        body.contains('AddPortMapping')) {
+      final extPort = _extractTag(body, 'NewExternalPort');
+      final intPort = _extractTag(body, 'NewInternalPort');
+      final protocol = _extractTag(body, 'NewProtocol');
+      final leaseStr = _extractTag(body, 'NewLeaseDuration') ?? '0';
+      final desc =
+          _extractTag(body, 'NewPortMappingDescription') ?? 'LibreShare';
+
+      final extPortInt = int.tryParse(extPort ?? '') ?? 0;
+      final leaseInt = int.tryParse(leaseStr) ?? 0;
+
+      if (conflictPort != null && extPortInt == conflictPort) {
+        request.response.statusCode = HttpStatus.internalServerError;
+        request.response.write(_soapFault(718, 'ConflictInMappingEntry'));
+        await request.response.close();
+        return;
+      }
+
+      if (permanentOnly && leaseInt > 0) {
+        request.response.statusCode = HttpStatus.internalServerError;
+        request.response.write(_soapFault(725, 'OnlyPermanentLeasesSupported'));
+        await request.response.close();
+        return;
+      }
+
+      _activeMappings.add({
+        'externalPort': extPortInt,
+        'internalPort': int.tryParse(intPort ?? '') ?? 0,
+        'protocol': protocol,
+        'leaseDuration': leaseInt,
+        'description': desc,
+      });
+
+      final resp = '''<?xml version="1.0"?>
+<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/">
+  <s:Body>
+    <u:AddPortMappingResponse xmlns:u="urn:schemas-upnp-org:service:WANIPConnection:1"/>
+  </s:Body>
+</s:Envelope>''';
+      request.response.statusCode = HttpStatus.ok;
+      request.response.write(resp);
+      await request.response.close();
+      return;
+    }
+
+    if (soapAction.contains('DeletePortMapping') ||
+        body.contains('DeletePortMapping')) {
+      final extPort =
+          int.tryParse(_extractTag(body, 'NewExternalPort') ?? '') ?? 0;
+      final protocol = _extractTag(body, 'NewProtocol');
+
+      _activeMappings.removeWhere(
+        (m) => m['externalPort'] == extPort && m['protocol'] == protocol,
+      );
+
+      final resp = '''<?xml version="1.0"?>
+<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/">
+  <s:Body>
+    <u:DeletePortMappingResponse xmlns:u="urn:schemas-upnp-org:service:WANIPConnection:1"/>
+  </s:Body>
+</s:Envelope>''';
+      request.response.statusCode = HttpStatus.ok;
+      request.response.write(resp);
+      await request.response.close();
+      return;
+    }
+
+    request.response.statusCode = HttpStatus.internalServerError;
+    request.response.write(_soapFault(606, 'ActionNotDefined'));
+    await request.response.close();
+  }
+
+  static String? _extractTag(String xml, String tag) {
+    final start = xml.indexOf('<$tag>');
+    final end = xml.indexOf('</$tag>');
+    if (start != -1 && end != -1 && end > start) {
+      return xml.substring(start + tag.length + 2, end).trim();
+    }
+    return null;
+  }
+
+  static String _soapFault(int code, String description) =>
+      '''<?xml version="1.0"?>
+<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/">
+  <s:Body>
+    <s:Fault>
+      <faultcode>s:Client</faultcode>
+      <faultstring>UPnPError</faultstring>
+      <detail>
+        <UPnPError xmlns="urn:schemas-upnp-org:control-1-0">
+          <errorCode>$code</errorCode>
+          <errorDescription>$description</errorDescription>
+        </UPnPError>
+      </detail>
+    </s:Fault>
+  </s:Body>
+</s:Envelope>''';
+}
--- a/packages/libreshare_core/lib/src/nat/fake_pcp_server.dart
+++ b/packages/libreshare_core/lib/src/nat/fake_pcp_server.dart
@@ -0,0 +1,124 @@
+// Fake NAT-PMP & PCP server for Increment 5b UDP port mapping tests.
+
+import 'dart:io';
+import 'dart:typed_data';
+
+class FakePcpServer {
+  FakePcpServer({
+    this.externalIp = '203.0.113.1',
+    this.resultCode = 0,
+    this.conflictPort,
+  });
+
+  final String externalIp;
+  int resultCode;
+  int? conflictPort;
+
+  RawDatagramSocket? _socket;
+  final List<Map<String, dynamic>> _activeMappings = [];
+
+  List<Map<String, dynamic>> get activeMappings =>
+      List.unmodifiable(_activeMappings);
+  int get port => _socket?.port ?? 0;
+
+  Future<void> start() async {
+    _socket = await RawDatagramSocket.bind(InternetAddress.loopbackIPv4, 0);
+    _socket!.listen(_handleDatagram);
+  }
+
+  Future<void> close() async {
+    _socket?.close();
+    _socket = null;
+  }
+
+  void _handleDatagram(RawSocketEvent event) {
+    if (event == RawSocketEvent.read) {
+      final dg = _socket?.receive();
+      if (dg == null || dg.data.isEmpty) return;
+
+      final version = dg.data[0];
+      if (version == 0) {
+        _handleNatPmp(dg);
+      } else if (version == 2) {
+        _handlePcp(dg);
+      }
+    }
+  }
+
+  void _handleNatPmp(Datagram dg) {
+    final data = dg.data;
+    if (data.length < 2) return;
+
+    final op = data[1];
+    final respOp = op | 0x80;
+
+    if (op == 0) {
+      // External IP request
+      final resp = ByteData(12);
+      resp.setUint8(0, 0); // Version 0
+      resp.setUint8(1, respOp);
+      resp.setUint16(2, resultCode); // Result code
+      resp.setUint32(4, 1000); // Epoch
+
+      // 4 bytes IPv4
+      final parts = externalIp.split('.').map(int.parse).toList();
+      resp.setUint8(8, parts[0]);
+      resp.setUint8(9, parts[1]);
+      resp.setUint8(10, parts[2]);
+      resp.setUint8(11, parts[3]);
+
+      _socket?.send(resp.buffer.asUint8List(), dg.address, dg.port);
+    } else if (op == 1 || op == 2) {
+      // Port map (1 = UDP, 2 = TCP)
+      if (data.length < 12) return;
+      final view = ByteData.sublistView(data);
+      final intPort = view.getUint16(4);
+      final extPortReq = view.getUint16(6);
+      final lifetime = view.getUint32(8);
+
+      var assignedExt = extPortReq == 0 ? intPort : extPortReq;
+      if (conflictPort != null && assignedExt == conflictPort) {
+        assignedExt = assignedExt + 1;
+      }
+
+      if (lifetime == 0) {
+        _activeMappings.removeWhere(
+          (m) =>
+              m['internalPort'] == intPort &&
+              m['protocol'] == (op == 2 ? 'TCP' : 'UDP'),
+        );
+      } else {
+        _activeMappings.add({
+          'internalPort': intPort,
+          'externalPort': assignedExt,
+          'protocol': op == 2 ? 'TCP' : 'UDP',
+          'lifetime': lifetime,
+        });
+      }
+
+      final resp = ByteData(16);
+      resp.setUint8(0, 0); // Version 0
+      resp.setUint8(1, respOp);
+      resp.setUint16(2, resultCode);
+      resp.setUint32(4, 1000); // Epoch
+      resp.setUint16(8, intPort);
+      resp.setUint16(10, assignedExt);
+      resp.setUint32(12, lifetime);
+
+      _socket?.send(resp.buffer.asUint8List(), dg.address, dg.port);
+    }
+  }
+
+  void _handlePcp(Datagram dg) {
+    // Basic PCP RFC 6887 response
+    final data = dg.data;
+    if (data.length < 24) return;
+
+    final opcode = data[1];
+    final resp = Uint8List.fromList(data);
+    resp[1] = opcode | 0x80; // Response bit
+    resp[3] = resultCode; // Result code
+
+    _socket?.send(resp, dg.address, dg.port);
+  }
+}
--- a/packages/libreshare_core/lib/src/nat/ssdp.dart
+++ b/packages/libreshare_core/lib/src/nat/ssdp.dart
@@ -0,0 +1,237 @@
+// SSDP Discovery & XML device parser for Increment 5b UPnP IGD.
+
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+import 'ip_classify.dart';
+
+final class SsdpDevice {
+  const SsdpDevice({
+    required this.location,
+    required this.st,
+    required this.usn,
+    this.server,
+    this.controlUrl,
+    this.serviceType,
+  });
+
+  final Uri location;
+  final String st;
+  final String usn;
+  final String? server;
+  final Uri? controlUrl;
+  final String? serviceType;
+
+  @override
+  String toString() => 'SsdpDevice($location, service: $serviceType)';
+}
+
+class SsdpClient {
+  SsdpClient({this.allowLoopback = false});
+
+  final bool allowLoopback;
+
+  static const String ssdpMulticastIpv4 = '239.255.255.250';
+  static const int ssdpPort = 1900;
+  static const int maxXmlBytes = 64 * 1024; // 64 KiB cap per D4
+
+  /// Discovers UPnP IGD devices via SSDP M-SEARCH.
+  /// If [unicastTarget] is specified, sends M-SEARCH directly to that address/port.
+  Future<List<SsdpDevice>> discover({
+    String? unicastHost,
+    int? unicastPort,
+    Duration timeout = const Duration(seconds: 3),
+  }) async {
+    RawDatagramSocket? socket;
+    final devices = <SsdpDevice>[];
+    final seenLocations = <String>{};
+
+    try {
+      socket = await RawDatagramSocket.bind(InternetAddress.anyIPv4, 0);
+      socket.broadcastEnabled = true;
+
+      const mSearch =
+          'M-SEARCH * HTTP/1.1\r\n'
+          'HOST: 239.255.255.250:1900\r\n'
+          'MAN: "ssdp:discover"\r\n'
+          'MX: 2\r\n'
+          'ST: urn:schemas-upnp-org:device:InternetGatewayDevice:1\r\n'
+          '\r\n';
+
+      final targetHost = unicastHost ?? ssdpMulticastIpv4;
+      final targetPort = unicastPort ?? ssdpPort;
+      final targetAddress = (await InternetAddress.lookup(targetHost)).first;
+
+      socket.send(utf8.encode(mSearch), targetAddress, targetPort);
+
+      final completer = Completer<void>();
+      final sub = socket.listen((event) {
+        if (event == RawSocketEvent.read) {
+          final dg = socket?.receive();
+          if (dg != null) {
+            final text = utf8.decode(dg.data, allowMalformed: true);
+            final device = _parseSsdpResponse(text);
+            if (device != null &&
+                seenLocations.add(device.location.toString())) {
+              devices.add(device);
+            }
+          }
+        }
+      });
+
+      await Future.any([Future<void>.delayed(timeout), completer.future]);
+
+      await sub.cancel();
+    } catch (_) {
+      // Best effort discovery
+    } finally {
+      socket?.close();
+    }
+
+    // Resolve control URLs for discovered devices with security hardening
+    final resolved = <SsdpDevice>[];
+    for (final dev in devices) {
+      final enriched = await resolveDeviceDescription(dev.location);
+      if (enriched != null) {
+        resolved.add(enriched);
+      }
+    }
+    return resolved;
+  }
+
+  /// Parses SSDP M-SEARCH response headers.
+  SsdpDevice? _parseSsdpResponse(String response) {
+    final lines = response.split(RegExp(r'\r?\n'));
+    if (lines.isEmpty || !lines[0].toUpperCase().contains('200 OK')) {
+      return null;
+    }
+
+    String? locationStr;
+    String? st;
+    String? usn;
+    String? server;
+
+    for (final line in lines.skip(1)) {
+      final colon = line.indexOf(':');
+      if (colon == -1) continue;
+      final key = line.substring(0, colon).trim().toUpperCase();
+      final val = line.substring(colon + 1).trim();
+
+      if (key == 'LOCATION') locationStr = val;
+      if (key == 'ST') st = val;
+      if (key == 'USN') usn = val;
+      if (key == 'SERVER') server = val;
+    }
+
+    if (locationStr == null || st == null || usn == null) return null;
+    final uri = Uri.tryParse(locationStr);
+    if (uri == null) return null;
+
+    return SsdpDevice(location: uri, st: st, usn: usn, server: server);
+  }
+
+  /// Downloads and parses the device description XML from [location] with D4 security gates.
+  Future<SsdpDevice?> resolveDeviceDescription(Uri location) async {
+    // Gate 1: Scheme must be HTTP
+    if (location.scheme != 'http') return null;
+
+    // Gate 2: Host must be private / link-local / loopback (if allowed)
+    final host = location.host;
+    final classification = IpClassifier.classify(host);
+    if (classification.category == IpCategory.invalid) {
+      // Domain names must be resolved or validated
+      try {
+        final addrs = await InternetAddress.lookup(host);
+        if (addrs.isEmpty) return null;
+        final addrClass = IpClassifier.classify(addrs.first.address);
+        if (!_isAllowedHost(addrClass)) return null;
+      } catch (_) {
+        return null;
+      }
+    } else {
+      if (!_isAllowedHost(classification)) return null;
+    }
+
+    HttpClient? client;
+    try {
+      client = HttpClient()
+        ..connectionTimeout = const Duration(seconds: 3)
+        ..autoUncompress = true;
+
+      final request = await client.getUrl(location);
+      request.followRedirects = false; // Never follow redirects per D4
+
+      final response = await request.close();
+      if (response.statusCode != HttpStatus.ok) return null;
+
+      // Gate 3: XML <= 64 KiB
+      final bytes = <int>[];
+      await for (final chunk in response) {
+        bytes.addAll(chunk);
+        if (bytes.length > maxXmlBytes) {
+          // Reject oversize XML per D4
+          return null;
+        }
+      }
+
+      final xml = utf8.decode(bytes, allowMalformed: true);
+
+      // Gate 4: No DTD per D4
+      if (xml.contains('<!DOCTYPE') || xml.contains('<!ENTITY')) {
+        return null;
+      }
+
+      // Extract service WANIPConnection or WANPPPConnection
+      final controlPath = _extractServiceControlUrl(xml);
+      if (controlPath == null) return null;
+
+      final controlUri = location.resolve(controlPath);
+
+      // Ensure control URL stays on the exact same origin
+      if (controlUri.host != location.host ||
+          controlUri.port != location.port) {
+        return null;
+      }
+
+      return SsdpDevice(
+        location: location,
+        st: 'urn:schemas-upnp-org:device:InternetGatewayDevice:1',
+        usn: location.toString(),
+        controlUrl: controlUri,
+        serviceType: 'urn:schemas-upnp-org:service:WANIPConnection:1',
+      );
+    } catch (_) {
+      return null;
+    } finally {
+      client?.close(force: true);
+    }
+  }
+
+  bool _isAllowedHost(IpClassification c) {
+    if (c.category == IpCategory.loopback) return allowLoopback;
+    return c.category == IpCategory.privateIpv4 ||
+        c.category == IpCategory.linkLocal;
+  }
+
+  static String? _extractServiceControlUrl(String xml) {
+    // Look for WANIPConnection or WANPPPConnection
+    var serviceIndex = xml.indexOf(
+      'urn:schemas-upnp-org:service:WANIPConnection:1',
+    );
+    if (serviceIndex == -1) {
+      serviceIndex = xml.indexOf(
+        'urn:schemas-upnp-org:service:WANPPPConnection:1',
+      );
+    }
+    if (serviceIndex == -1) return null;
+
+    final afterService = xml.substring(serviceIndex);
+    final ctrlStart = afterService.indexOf('<controlURL>');
+    final ctrlEnd = afterService.indexOf('</controlURL>');
+    if (ctrlStart != -1 && ctrlEnd != -1 && ctrlEnd > ctrlStart) {
+      return afterService.substring(ctrlStart + 12, ctrlEnd).trim();
+    }
+    return null;
+  }
+}
--- a/packages/libreshare_core/lib/src/nat/upnp_igd.dart
+++ b/packages/libreshare_core/lib/src/nat/upnp_igd.dart
@@ -0,0 +1,160 @@
+// UPnP IGD SOAP client for Increment 5b port mapping.
+
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+import 'port_mapping.dart';
+
+class UpnpIgdClient {
+  UpnpIgdClient({
+    required this.controlUrl,
+    this.serviceType = 'urn:schemas-upnp-org:service:WANIPConnection:1',
+  });
+
+  final Uri controlUrl;
+  final String serviceType;
+
+  /// Retrieves the external public IP address from the IGD gateway.
+  Future<String?> getExternalIpAddress({
+    Duration timeout = const Duration(seconds: 3),
+  }) async {
+    final body =
+        '''<?xml version="1.0"?>
+<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" s:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/">
+  <s:Body>
+    <u:GetExternalIPAddress xmlns:u="$serviceType"/>
+  </s:Body>
+</s:Envelope>''';
+
+    final resp = await _sendSoap('GetExternalIPAddress', body, timeout);
+    if (resp == null) return null;
+    return _extractTag(resp, 'NewExternalIPAddress');
+  }
+
+  /// Adds a port mapping on the IGD gateway.
+  /// If 718 (ConflictInMappingEntry) occurs, tries incrementing externalPort up to 5 times.
+  /// If 725 (OnlyPermanentLeasesSupported) occurs, retries with lease = 0.
+  Future<PortMapping?> addPortMapping({
+    required int internalPort,
+    int? externalPort,
+    String? internalClient,
+    Duration lease = const Duration(hours: 1),
+    PortMappingProtocol protocol = PortMappingProtocol.tcp,
+    String description = 'LibreShare',
+    Duration timeout = const Duration(seconds: 3),
+  }) async {
+    final clientIp = internalClient ?? '192.168.1.100'; // Fallback
+    var targetExtPort = externalPort ?? internalPort;
+    var targetLease = lease.inSeconds;
+
+    for (var attempt = 0; attempt < 5; attempt++) {
+      final body =
+          '''<?xml version="1.0"?>
+<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" s:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/">
+  <s:Body>
+    <u:AddPortMapping xmlns:u="$serviceType">
+      <NewRemoteHost></NewRemoteHost>
+      <NewExternalPort>$targetExtPort</NewExternalPort>
+      <NewProtocol>${protocol.wireValue}</NewProtocol>
+      <NewInternalPort>$internalPort</NewInternalPort>
+      <NewInternalClient>$clientIp</NewInternalClient>
+      <NewEnabled>1</NewEnabled>
+      <NewPortMappingDescription>$description</NewPortMappingDescription>
+      <NewLeaseDuration>$targetLease</NewLeaseDuration>
+    </u:AddPortMapping>
+  </s:Body>
+</s:Envelope>''';
+
+      final resp = await _sendSoap('AddPortMapping', body, timeout);
+      if (resp != null) {
+        if (resp.contains('AddPortMappingResponse')) {
+          final extIp =
+              await getExternalIpAddress(timeout: timeout) ?? '0.0.0.0';
+          return PortMapping(
+            internalPort: internalPort,
+            externalPort: targetExtPort,
+            externalIp: extIp,
+            protocol: protocol,
+            leaseDuration: Duration(seconds: targetLease),
+            createdAt: DateTime.now(),
+            description: description,
+          );
+        }
+
+        // Check SOAP fault errors
+        final errCodeStr = _extractTag(resp, 'errorCode');
+        final errCode = int.tryParse(errCodeStr ?? '');
+
+        if (errCode == 718) {
+          // Conflict: try next port
+          targetExtPort++;
+          continue;
+        } else if (errCode == 725 && targetLease > 0) {
+          // Only permanent leases supported: retry with 0
+          targetLease = 0;
+          continue;
+        }
+      }
+      return null;
+    }
+    return null;
+  }
+
+  /// Deletes a port mapping from the gateway.
+  Future<bool> deletePortMapping({
+    required int externalPort,
+    PortMappingProtocol protocol = PortMappingProtocol.tcp,
+    Duration timeout = const Duration(seconds: 3),
+  }) async {
+    final body =
+        '''<?xml version="1.0"?>
+<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" s:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/">
+  <s:Body>
+    <u:DeletePortMapping xmlns:u="$serviceType">
+      <NewRemoteHost></NewRemoteHost>
+      <NewExternalPort>$externalPort</NewExternalPort>
+      <NewProtocol>${protocol.wireValue}</NewProtocol>
+    </u:DeletePortMapping>
+  </s:Body>
+</s:Envelope>''';
+
+    final resp = await _sendSoap('DeletePortMapping', body, timeout);
+    return resp != null && resp.contains('DeletePortMappingResponse');
+  }
+
+  Future<String?> _sendSoap(
+    String action,
+    String xmlBody,
+    Duration timeout,
+  ) async {
+    HttpClient? client;
+    try {
+      client = HttpClient()..connectionTimeout = timeout;
+      final req = await client.postUrl(controlUrl).timeout(timeout);
+      req.headers.contentType = ContentType('text', 'xml', charset: 'utf-8');
+      req.headers.add('SOAPACTION', '"$serviceType#$action"');
+      req.write(xmlBody);
+
+      final resp = await req.close().timeout(timeout);
+      final bytes = await resp.fold<List<int>>(
+        [],
+        (acc, chunk) => acc..addAll(chunk),
+      );
+      return utf8.decode(bytes, allowMalformed: true);
+    } catch (_) {
+      return null;
+    } finally {
+      client?.close(force: true);
+    }
+  }
+
+  static String? _extractTag(String xml, String tag) {
+    final start = xml.indexOf('<$tag>');
+    final end = xml.indexOf('</$tag>');
+    if (start != -1 && end != -1 && end > start) {
+      return xml.substring(start + tag.length + 2, end).trim();
+    }
+    return null;
+  }
+}
