@@ -0,0 +1,90 @@
+// CLONE-ONLY PROFILING INSTRUMENTATION (never part of the real tree).
+// Enabled by LS_PROF=1. LS_PROF_NOSHA=1 turns every SHA-256 into a no-op
+// (both sides agree on zeros); LS_PROF_NODISK=1 skips chunk file writes and
+// the final file hash.
+import 'dart:async';
+import 'dart:io';
+
+class LsProf {
+  LsProf._();
+
+  static final bool on = Platform.environment['LS_PROF'] == '1';
+  static final bool noSha = Platform.environment['LS_PROF_NOSHA'] == '1';
+  static final bool noDisk = Platform.environment['LS_PROF_NODISK'] == '1';
+
+  static final Map<String, int> _us = <String, int>{};
+  static final Map<String, int> _n = <String, int>{};
+  static final Stopwatch _wall = Stopwatch();
+  static Timer? _lagTimer;
+  static int _ticks = 0, _lagMaxUs = 0, _lagSumUs = 0;
+
+  static Stopwatch? start() => on ? (Stopwatch()..start()) : null;
+
+  static void add(String key, Stopwatch? sw) {
+    if (sw == null) return;
+    _us[key] = (_us[key] ?? 0) + sw.elapsedMicroseconds;
+    _n[key] = (_n[key] ?? 0) + 1;
+  }
+
+  static void startLag() {
+    if (!on) return;
+    _wall.start();
+    final sw = Stopwatch()..start();
+    var last = 0;
+    _lagTimer = Timer.periodic(const Duration(milliseconds: 1), (_) {
+      final now = sw.elapsedMicroseconds;
+      final late = now - last - 1000;
+      last = now;
+      _ticks++;
+      if (late > 0) {
+        _lagSumUs += late;
+        if (late > _lagMaxUs) _lagMaxUs = late;
+      }
+    });
+  }
+
+  static String _cpu() {
+    try {
+      final s = File('/proc/self/stat').readAsStringSync();
+      final f = s.substring(s.lastIndexOf(')') + 2).split(' ');
+      final ut = int.parse(f[11]), st = int.parse(f[12]);
+      return 'utime_s=${(ut / 100).toStringAsFixed(2)}|stime_s=${(st / 100).toStringAsFixed(2)}';
+    } catch (_) {
+      return 'utime_s=na|stime_s=na';
+    }
+  }
+
+  static Future<void> dump(String role) async {
+    final tr = Platform.environment['LS_PROF_TRACE'];
+    if (tr != null) File(tr).writeAsStringSync('dump role=$role on=$on pid=$pid\n', mode: FileMode.append);
+    if (!on) return;
+    _lagTimer?.cancel();
+    final b = StringBuffer();
+    _us.forEach((k, v) {
+      b.writeln('PROF|$role|stage|$k|n=${_n[k]}|total_us=$v');
+    });
+    b.writeln(
+      'PROF|$role|lag|ticks=$_ticks|max_us=$_lagMaxUs|'
+      'mean_us=${_ticks == 0 ? 0 : _lagSumUs ~/ _ticks}',
+    );
+    b.writeln('PROF|$role|proc|wall_us=${_wall.elapsedMicroseconds}|${_cpu()}');
+    // Per-thread CPU (threads grouped by kernel comm name).
+    final perComm = <String, double>{};
+    final perCount = <String, int>{};
+    try {
+      for (final t in Directory('/proc/self/task').listSync()) {
+        final comm = File('${t.path}/comm').readAsStringSync().trim();
+        final f = File('${t.path}/stat').readAsStringSync();
+        final g = f.substring(f.lastIndexOf(')') + 2).split(' ');
+        final secs = (int.parse(g[11]) + int.parse(g[12])) / 100.0;
+        perComm[comm] = (perComm[comm] ?? 0) + secs;
+        perCount[comm] = (perCount[comm] ?? 0) + 1;
+      }
+    } catch (_) {}
+    perComm.forEach((k, v) {
+      b.writeln('PROF|$role|thread|$k|n=${perCount[k]}|cpu_s=${v.toStringAsFixed(2)}');
+    });
+    stderr.write(b.toString());
+    await stderr.flush();
+  }
+}
