+import 'dart:convert';
+import 'dart:io';
+import 'dart:typed_data';
+
+const int kShareLinkMaxChars = 2048;
+const String kDefaultLandingBase = 'https://libreshare.github.io/r';
+
+enum ShareLinkError {
+  tooLong,
+  notALink,
+  unsupportedVersion,
+  missingParam,
+  duplicateParam,
+  badHost,
+  badToken,
+  badKey,
+  badMaxReceivers,
+  badExpiry,
+  badAlias,
+  badFingerprintHint,
+}
+
+/// toString is exactly 'ShareLinkException(`error.name`)': NEVER any part of the input.
+final class ShareLinkException implements Exception {
+  const ShareLinkException(this.error);
+  final ShareLinkError error;
+
+  @override
+  String toString() => 'ShareLinkException(${error.name})';
+}
+
+final class ShareLink {
+  final int version; // 1
+  final String host; // lower-case DNS name, no port
+  final Uint8List token; // 16 bytes
+  final Uint8List rootKey; // 32 bytes
+  final int maxReceivers; // default 1, 0 = anyone
+  final int? expiresAtUnixSeconds;
+  final String? senderAlias; // display hint only
+  final String? senderFingerprintHint; // display hint only, upper-case hex
+
+  const ShareLink._({
+    required this.version,
+    required this.host,
+    required this.token,
+    required this.rootKey,
+    required this.maxReceivers,
+    this.expiresAtUnixSeconds,
+    this.senderAlias,
+    this.senderFingerprintHint,
+  });
+
+  factory ShareLink.parse(String input, {bool allowDeveloperHosts = false}) {
+    final raw = input.trim();
+    if (raw.length > kShareLinkMaxChars) {
+      throw const ShareLinkException(ShareLinkError.tooLong);
+    }
+
+    String fragmentPart;
+    if (raw.startsWith('https://')) {
+      final hashIndex = raw.indexOf('#');
+      if (hashIndex < 0) {
+        throw const ShareLinkException(ShareLinkError.notALink);
+      }
+      final urlPrefix = raw.substring(0, hashIndex);
+      final uri = Uri.tryParse(urlPrefix);
+      if (uri == null || (uri.path != '/r' && uri.path != '/r/')) {
+        throw const ShareLinkException(ShareLinkError.notALink);
+      }
+      fragmentPart = raw.substring(hashIndex + 1);
+    } else if (raw.startsWith('libreshare://r')) {
+      final qIndex = raw.indexOf('?');
+      final hashIndex = raw.indexOf('#');
+      if (qIndex >= 0) {
+        fragmentPart = raw.substring(qIndex + 1);
+      } else if (hashIndex >= 0) {
+        fragmentPart = raw.substring(hashIndex + 1);
+      } else {
+        throw const ShareLinkException(ShareLinkError.notALink);
+      }
+    } else {
+      throw const ShareLinkException(ShareLinkError.notALink);
+    }
+
+    if (fragmentPart.isEmpty) {
+      throw const ShareLinkException(ShareLinkError.missingParam);
+    }
+
+    final pairs = fragmentPart.split('&');
+    final seen = <String>{};
+    final params = <String, String>{};
+
+    for (final pair in pairs) {
+      if (pair.isEmpty) continue;
+      final eqIndex = pair.indexOf('=');
+      final key = eqIndex >= 0 ? pair.substring(0, eqIndex) : pair;
+      final val = eqIndex >= 0 ? pair.substring(eqIndex + 1) : '';
+
+      const knownKeys = {'v', 'h', 't', 'k', 'm', 'e', 'n', 'fp', 'd', 'pin'};
+      if (knownKeys.contains(key) && seen.contains(key)) {
+        throw const ShareLinkException(ShareLinkError.duplicateParam);
+      }
+      seen.add(key);
+      params[key] = val;
+    }
+
+    // Required params: v, h, t, k
+    for (final req in const ['v', 'h', 't', 'k']) {
+      if (!params.containsKey(req)) {
+        throw const ShareLinkException(ShareLinkError.missingParam);
+      }
+    }
+
+    // Version
+    final vStr = params['v']!;
+    if (vStr != '1') {
+      throw const ShareLinkException(ShareLinkError.unsupportedVersion);
+    }
+
+    // Host
+    final rawHost = params['h']!;
+    final host = _validateHost(
+      rawHost,
+      allowDeveloperHosts: allowDeveloperHosts,
+    );
+
+    // Token: 16 bytes base64url, no padding, canonical
+    final tokenBytes = _decodeBase64UrlExact(
+      params['t']!,
+      16,
+      ShareLinkError.badToken,
+    );
+
+    // Key: 32 bytes base64url, no padding, canonical
+    final keyBytes = _decodeBase64UrlExact(
+      params['k']!,
+      32,
+      ShareLinkError.badKey,
+    );
+
+    // Max receivers: m
+    int maxReceivers = 1;
+    if (params.containsKey('m')) {
+      final mStr = params['m']!;
+      final mVal = int.tryParse(mStr);
+      if (mVal == null || mVal < 0 || mVal > 1000 || mStr != mVal.toString()) {
+        throw const ShareLinkException(ShareLinkError.badMaxReceivers);
+      }
+      maxReceivers = mVal;
+    }
+
+    // Expiry: e
+    int? expiresAtUnixSeconds;
+    if (params.containsKey('e')) {
+      final eStr = params['e']!;
+      final eVal = int.tryParse(eStr);
+      if (eVal == null ||
+          eVal < 1 ||
+          eVal > 1099511627776 || // 2^40
+          eStr != eVal.toString()) {
+        throw const ShareLinkException(ShareLinkError.badExpiry);
+      }
+      expiresAtUnixSeconds = eVal;
+    }
+
+    // Alias: n
+    String? senderAlias;
+    if (params.containsKey('n')) {
+      senderAlias = _validateAlias(params['n']!);
+    }
+
+    // Fingerprint hint: fp
+    String? senderFingerprintHint;
+    if (params.containsKey('fp')) {
+      final fpRaw = params['fp']!;
+      if (fpRaw.length < 8 ||
+          fpRaw.length > 64 ||
+          !RegExp(r'^[0-9A-Fa-f]+$').hasMatch(fpRaw)) {
+        throw const ShareLinkException(ShareLinkError.badFingerprintHint);
+      }
+      senderFingerprintHint = fpRaw.toUpperCase();
+    }
+
+    return ShareLink._(
+      version: 1,
+      host: host,
+      token: tokenBytes,
+      rootKey: keyBytes,
+      maxReceivers: maxReceivers,
+      expiresAtUnixSeconds: expiresAtUnixSeconds,
+      senderAlias: senderAlias,
+      senderFingerprintHint: senderFingerprintHint,
+    );
+  }
+
+  static String _validateHost(String raw, {required bool allowDeveloperHosts}) {
+    if (raw.isEmpty) {
+      throw const ShareLinkException(ShareLinkError.badHost);
+    }
+
+    if (allowDeveloperHosts) {
+      final lower = raw.toLowerCase();
+      // Allow localhost with optional port
+      if (lower == 'localhost' || lower.startsWith('localhost:')) return lower;
+      // Allow IP literal with optional port
+      final colonIndex = lower.indexOf(':');
+      final hostPart = colonIndex >= 0 ? lower.substring(0, colonIndex) : lower;
+      if (InternetAddress.tryParse(hostPart) != null) return lower;
+    }
+
+    final lower = raw.toLowerCase();
+    if (lower.length > 253) {
+      throw const ShareLinkException(ShareLinkError.badHost);
+    }
+    if (lower.contains('@') ||
+        lower.contains(':') ||
+        lower.contains('[') ||
+        lower.contains(']') ||
+        lower.contains('%') ||
+        lower.endsWith('.')) {
+      throw const ShareLinkException(ShareLinkError.badHost);
+    }
+
+    // Check IP literals
+    if (InternetAddress.tryParse(lower) != null) {
+      throw const ShareLinkException(ShareLinkError.badHost);
+    }
+    // Check decimal IP (all digits) or hex IP
+    if (int.tryParse(lower) != null || lower.contains('0x')) {
+      throw const ShareLinkException(ShareLinkError.badHost);
+    }
+
+    // Check banned domains
+    if (lower == 'localhost' ||
+        lower.endsWith('.localhost') ||
+        lower.endsWith('.local') ||
+        lower.endsWith('.internal') ||
+        lower.endsWith('.lan') ||
+        lower.endsWith('.home.arpa') ||
+        lower.endsWith('.test') ||
+        lower.endsWith('.invalid') ||
+        lower.endsWith('.example')) {
+      throw const ShareLinkException(ShareLinkError.badHost);
+    }
+
+    final labels = lower.split('.');
+    if (labels.length < 2) {
+      throw const ShareLinkException(ShareLinkError.badHost);
+    }
+
+    final labelRegex = RegExp(r'^[a-z0-9]([a-z0-9-]*[a-z0-9])?$');
+    for (final label in labels) {
+      if (label.isEmpty || label.length > 63 || !labelRegex.hasMatch(label)) {
+        throw const ShareLinkException(ShareLinkError.badHost);
+      }
+    }
+
+    // TLD cannot be all digits
+    if (RegExp(r'^[0-9]+$').hasMatch(labels.last)) {
+      throw const ShareLinkException(ShareLinkError.badHost);
+    }
+
+    return lower;
+  }
+
+  static Uint8List _decodeBase64UrlExact(
+    String input,
+    int expectedBytes,
+    ShareLinkError error,
+  ) {
+    if (input.contains('=') || !RegExp(r'^[A-Za-z0-9_-]+$').hasMatch(input)) {
+      throw ShareLinkException(error);
+    }
+    final padLength = (4 - (input.length % 4)) % 4;
+    final padded = input + ('=' * padLength);
+    Uint8List bytes;
+    try {
+      bytes = Uint8List.fromList(base64Url.decode(padded));
+    } catch (_) {
+      throw ShareLinkException(error);
+    }
+    if (bytes.length != expectedBytes) {
+      throw ShareLinkException(error);
+    }
+    // Canonical check: re-encode must match input exactly
+    final reEncoded = base64UrlEncode(bytes).replaceAll('=', '');
+    if (reEncoded != input) {
+      throw ShareLinkException(error);
+    }
+    return bytes;
+  }
+
+  static String _validateAlias(String raw) {
+    String decoded;
+    try {
+      decoded = Uri.decodeComponent(raw);
+    } catch (_) {
+      throw const ShareLinkException(ShareLinkError.badAlias);
+    }
+    if (decoded.isEmpty || decoded.length > 64) {
+      throw const ShareLinkException(ShareLinkError.badAlias);
+    }
+    for (final cu in decoded.codeUnits) {
+      // Control characters: 0x00..0x1F, 0x7F..0x9F
+      if ((cu >= 0x00 && cu <= 0x1F) || (cu >= 0x7F && cu <= 0x9F)) {
+        throw const ShareLinkException(ShareLinkError.badAlias);
+      }
+      // Bidi overrides / isolates: U+202A..U+202E, U+2066..U+2069
+      if ((cu >= 0x202A && cu <= 0x202E) || (cu >= 0x2066 && cu <= 0x2069)) {
+        throw const ShareLinkException(ShareLinkError.badAlias);
+      }
+    }
+    return decoded;
+  }
+
+  String get tokenB64 => base64UrlEncode(token).replaceAll('=', '');
+
+  String get keyB64 => base64UrlEncode(rootKey).replaceAll('=', '');
+
+  Uri get originBase {
+    if (host.contains(':')) {
+      final parts = host.split(':');
+      return Uri(scheme: 'https', host: parts[0], port: int.parse(parts[1]));
+    }
+    return Uri.https(host);
+  }
+
+  bool isExpired(DateTime now) {
+    if (expiresAtUnixSeconds == null) return false;
+    final nowSeconds = now.toUtc().millisecondsSinceEpoch ~/ 1000;
+    return nowSeconds >= expiresAtUnixSeconds!;
+  }
+
+  String _buildFragment() {
+    final sb = StringBuffer();
+    sb.write('v=1&h=$host&t=$tokenB64&k=$keyB64&m=$maxReceivers');
+    if (expiresAtUnixSeconds != null) {
+      sb.write('&e=$expiresAtUnixSeconds');
+    }
+    if (senderAlias != null) {
+      sb.write(
+        '&n=${Uri.encodeComponent(senderAlias!).replaceAll("'", "%27")}',
+      );
+    }
+    if (senderFingerprintHint != null) {
+      sb.write('&fp=$senderFingerprintHint');
+    }
+    return sb.toString();
+  }
+
+  String encode({String landingBase = kDefaultLandingBase}) {
+    return '$landingBase#${_buildFragment()}';
+  }
+
+  String encodeDeepLink() {
+    return 'libreshare://r?${_buildFragment()}';
+  }
+
+  @override
+  bool operator ==(Object other) {
+    if (identical(this, other)) return true;
+    if (other is! ShareLink) return false;
+    return other.version == version &&
+        other.host == host &&
+        _bytesEqual(other.token, token) &&
+        _bytesEqual(other.rootKey, rootKey) &&
+        other.maxReceivers == maxReceivers &&
+        other.expiresAtUnixSeconds == expiresAtUnixSeconds &&
+        other.senderAlias == senderAlias &&
+        other.senderFingerprintHint == senderFingerprintHint;
+  }
+
+  @override
+  int get hashCode => Object.hash(
+    version,
+    host,
+    Object.hashAll(token),
+    Object.hashAll(rootKey),
+    maxReceivers,
+    expiresAtUnixSeconds,
+    senderAlias,
+    senderFingerprintHint,
+  );
+
+  static bool _bytesEqual(Uint8List a, Uint8List b) {
+    if (a.length != b.length) return false;
+    for (var i = 0; i < a.length; i++) {
+      if (a[i] != b[i]) return false;
+    }
+    return true;
+  }
+
+  @override
+  String toString() => 'ShareLink(redacted)';
+}
