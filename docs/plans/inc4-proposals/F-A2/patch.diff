   static File sidecarFor(File partialFile) => File('${partialFile.path}.json');
 
+  /// `<partial>.json.acks`: append-only, one acked chunk index per line.
+  static File journalFor(File partialFile) =>
+      File('${sidecarFor(partialFile).path}.acks');
+
+  /// Reads the journal's complete records that are inside [0, chunkCount).
+  /// A trailing record without its newline (killed mid-append) is cut off the
+  /// file so later appends start on a fresh line.
+  static Set<int> _readJournal(File journal, int chunkCount) {
+    final out = <int>{};
+    try {
+      if (!journal.existsSync()) return out;
+      final bytes = journal.readAsBytesSync();
+      final cut = bytes.lastIndexOf(0x0A);
+      if (cut != bytes.length - 1) {
+        journal.writeAsBytesSync(bytes.sublist(0, cut + 1));
+      }
+      for (final line in utf8.decode(bytes.sublist(0, cut + 1)).split('\n')) {
+        final v = int.tryParse(line);
+        if (v != null && v >= 0 && v < chunkCount) out.add(v);
+      }
+    } catch (_) {
+      // unreadable journal: the sidecar bitmap alone is used
+    }
+    return out;
+  }
