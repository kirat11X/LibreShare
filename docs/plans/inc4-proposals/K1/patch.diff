+bool _isFolderWritable(String path) {
+  try {
+    final dir = Directory(path);
+    dir.createSync(recursive: true);
+    final probe = File(
+      '${dir.path}${Platform.pathSeparator}.lsprobe-${DateTime.now().microsecondsSinceEpoch}',
+    );
+    probe.createSync(exclusive: true);
+    probe.deleteSync();
+    return true;
+  } on Object {
+    return false;
+  }
+}
