+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:libreshare_core/libreshare_core.dart';
+
+import '../l10n_strings.dart';
+import '../providers/engine_provider.dart';
+
+/// Screen for QR pairing: shows this device's pair invite as a QR code and
+/// copyable text, and provides a field to paste and redeem an invite link.
+class PairScreen extends ConsumerStatefulWidget {
+  const PairScreen({super.key});
+
+  @override
+  ConsumerState<PairScreen> createState() => _PairScreenState();
+}
+
+class _PairScreenState extends ConsumerState<PairScreen> {
+  final _pasteController = TextEditingController();
+  String? _statusMessage;
+  String? _redeemingAlias;
+  bool _isRedeeming = false;
+  String? _inviteUri;
+
+  @override
+  void dispose() {
+    _pasteController.dispose();
+    super.dispose();
+  }
+
+  void _ensureInvite() {
+    if (_inviteUri != null) return;
+    final engine = ref.read(engineOrNullProvider);
+    if (engine != null && engine.isListening) {
+      try {
+        _inviteUri = engine.createPairInvite();
+      } catch (_) {}
+    }
+  }
+
+  Future<void> _copyInvite() async {
+    _ensureInvite();
+    final uri = _inviteUri;
+    if (uri != null) {
+      await Clipboard.setData(ClipboardData(text: uri));
+      if (mounted) {
+        ScaffoldMessenger.of(context)
+            .showSnackBar(SnackBar(content: Text(tr('pair.linkCopied'))));
+      }
+    }
+  }
+
+  Future<void> _redeem() async {
+    final text = _pasteController.text.trim();
+    if (text.isEmpty) return;
+    final engine = ref.read(engineOrNullProvider);
+    if (engine == null) return;
+
+    final q = Uri.tryParse(text)?.queryParameters ?? {};
+    final alias = q['n'] ?? 'peer';
+
+    setState(() {
+      _statusMessage = null;
+      _redeemingAlias = alias;
+      _isRedeeming = true;
+    });
+
+    try {
+      final ok = await engine.redeemPairInvite(text);
+      if (!mounted) return;
+      if (ok) {
+        setState(() {
+          _statusMessage = tr('pair.success', {'alias': alias});
+        });
+      } else {
+        setState(() {
+          _statusMessage = tr('pair.declined');
+        });
+      }
+    } on LsException catch (e) {
+      if (!mounted) return;
+      final msg = e.message.toLowerCase();
+      if (msg.contains('expired')) {
+        setState(() {
+          _statusMessage = tr('pair.expired');
+        });
+      } else if (msg.contains('used')) {
+        setState(() {
+          _statusMessage = tr('pair.used');
+        });
+      } else if (e.code == LsErrorCode.notFound) {
+        setState(() {
+          _statusMessage = '${tr('pair.expired')} ${tr('pair.used')}';
+        });
+      } else {
+        setState(() {
+          _statusMessage = tr('pair.invalid');
+        });
+      }
+    } catch (e) {
+      if (!mounted) return;
+      setState(() {
+        _statusMessage = tr('pair.invalid');
+      });
+    } finally {
+      if (mounted) {
+        setState(() {
+          _isRedeeming = false;
+        });
+      }
+    }
+  }
+
+  String _maskedInvite(String? uri) {
+    if (uri == null) return tr('pair.pasteField');
+    return uri.replaceAll(RegExp(r's=[^&]+'), 's=••••••••');
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final engine = ref.watch(engineOrNullProvider);
+    _ensureInvite();
+
+    final contacts = engine?.currentContacts ?? const [];
+    final pairedContact = _redeemingAlias != null
+        ? contacts
+              .where(
+                (c) =>
+                    c.alias == _redeemingAlias && c.trust == PeerTrust.trusted,
+              )
+              .firstOrNull
+        : null;
+    final message =
+        _statusMessage ??
+        (pairedContact != null
+            ? tr('pair.success', {'alias': pairedContact.alias})
+            : null);
+
+    return Scaffold(
+      key: const Key('pair-screen'),
+      appBar: AppBar(title: Text(tr('pair.title'))),
+      body: Center(
+        child: ConstrainedBox(
+          constraints: const BoxConstraints(maxWidth: 480),
+          child: SingleChildScrollView(
+            padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.stretch,
+              mainAxisSize: MainAxisSize.min,
+              children: [
+                Row(
+                  crossAxisAlignment: CrossAxisAlignment.center,
+                  children: [
+                    Container(
+                      key: const Key('pair-qr-display'),
+                      width: 96,
+                      height: 96,
+                      decoration: BoxDecoration(
+                        border: Border.all(color: theme.dividerColor),
+                        borderRadius: BorderRadius.circular(12),
+                        color: theme.colorScheme.surfaceContainerHighest
+                            .withValues(alpha: 0.3),
+                      ),
+                      child: Center(
+                        child: Icon(
+                          Icons.qr_code_2,
+                          size: 64,
+                          color: theme.colorScheme.primary,
+                        ),
+                      ),
+                    ),
+                    const SizedBox(width: 12),
+                    Expanded(
+                      child: Column(
+                        crossAxisAlignment: CrossAxisAlignment.start,
+                        children: [
+                          Text(
+                            tr('pair.inviteHeading'),
+                            style: theme.textTheme.titleSmall,
+                          ),
+                          const SizedBox(height: 4),
+                          ExcludeSemantics(
+                            child: Text(
+                              _maskedInvite(_inviteUri),
+                              key: const Key('pair-invite-text'),
+                              style: theme.textTheme.bodySmall?.copyWith(
+                                fontFamily: 'monospace',
+                                fontSize: 10,
+                              ),
+                              maxLines: 2,
+                              overflow: TextOverflow.ellipsis,
+                            ),
+                          ),
+                          const SizedBox(height: 6),
+                          OutlinedButton.icon(
+                            key: const Key('pair-copy-button'),
+                            onPressed: _copyInvite,
+                            icon: const Icon(Icons.copy, size: 16),
+                            label: Text(tr('pair.copyLink')),
+                          ),
+                        ],
+                      ),
+                    ),
+                  ],
+                ),
+                const SizedBox(height: 8),
+                const Divider(height: 16),
+                const SizedBox(height: 4),
+                Text(tr('pair.pastePrompt'), style: theme.textTheme.titleSmall),
+                const SizedBox(height: 6),
+                TextField(
+                  key: const Key('pair-paste-field'),
+                  controller: _pasteController,
+                  decoration: InputDecoration(
+                    hintText: tr('pair.pasteField'),
+                    border: const OutlineInputBorder(),
+                    isDense: true,
+                    contentPadding: const EdgeInsets.symmetric(
+                      horizontal: 12,
+                      vertical: 10,
+                    ),
+                  ),
+                ),
+                const SizedBox(height: 8),
+                FilledButton.icon(
+                  key: const Key('pair-redeem-button'),
+                  onPressed: _isRedeeming ? null : _redeem,
+                  icon: const Icon(Icons.link, size: 18),
+                  label: Text(tr('pair.redeem')),
+                ),
+                if (message != null) ...[
+                  const SizedBox(height: 10),
+                  Text(
+                    message,
+                    key: const Key('pair-status-message'),
+                    style: theme.textTheme.bodyMedium?.copyWith(
+                      color: message.contains('Paired with')
+                          ? theme.colorScheme.primary
+                          : theme.colorScheme.error,
+                      fontWeight: FontWeight.bold,
+                    ),
+                    textAlign: TextAlign.center,
+                  ),
+                ],
+              ],
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+}
